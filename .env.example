# VIGIL environment variables. Copy to .env.local and fill in what you need.
# Nothing is required for demo mode: `npm install && npm run dev` starts with the simulator and an
# embedded database. Secrets here are read on the server only and never sent to the browser.

# --- Mode -----------------------------------------------------------------------
# demo (default): simulator on, demo accounts admin@vigil.example / analyst@vigil.example.
# production: no simulator, no demo accounts; the first admin comes from VIGIL_ADMIN_* below.
# On a production server (NODE_ENV=production) VIGIL_MODE is REQUIRED; VIGIL refuses to start without it.
# Production mode also deactivates the demo accounts if a demo database is reused.
VIGIL_MODE=demo
# Demo account password (demo mode only). Default: vigil-demo-2026 (shown on the login page).
VIGIL_DEMO_PASSWORD=
# First admin in production mode, created when the users table is empty (password 12+ characters).
VIGIL_ADMIN_EMAIL=
VIGIL_ADMIN_PASSWORD=
# Public URL of VIGIL, used for links in notifications (e.g. https://vigil.example.com).
VIGIL_PUBLIC_URL=

# Reverse proxies in front of VIGIL that append to X-Forwarded-For (default 1). The client IP for
# sign-in limits and the audit log is taken that many entries from the right. 0 = use X-Real-IP only.
VIGIL_TRUSTED_PROXY_HOPS=

# --- Database ---------------------------------------------------------------------
# PostgreSQL 15+ (Supabase or local Docker). Without it, an embedded PostgreSQL (PGlite) stores data in
# VIGIL_DATA_DIR (default .data/pglite) and the web server runs the worker itself.
DATABASE_URL=
DATABASE_POOL_SIZE=5
VIGIL_DATA_DIR=

# --- Worker -------------------------------------------------------------------------
# Run the ingestion/detection worker inside the web server. Default: on with the embedded database,
# off with DATABASE_URL (then run `npm run worker` as a separate process).
VIGIL_INPROCESS_WORKER=
VIGIL_WORKER_INTERVAL_MS=10000
# Simulator (demo mode only). Set to 0 to show only real NEXORA events.
VIGIL_SIMULATOR=

# --- NEXORA connector ---------------------------------------------------------------------
# NEXORA base URL, e.g. http://localhost:3000
NEXORA_URL=
# SIEM key with scope security:read (NEXORA → Settings → API keys → kind SIEM). Polling only.
NEXORA_SECURITY_API_KEY=
# Separate SIEM key with scope security:respond, used only when an admin approves a response action.
NEXORA_RESPONSE_API_KEY=
NEXORA_POLL_SECONDS=15
NEXORA_PAGE_SIZE=200
# Optional push receiver POST /api/ingest/nexora (HMAC X-Nexora-Signature). Disabled when empty.
VIGIL_INGEST_SECRET=

# --- Notifications (high-severity alerts) ------------------------------------------------
# Email through Resend: all three are needed.
RESEND_API_KEY=
VIGIL_ALERT_EMAIL_FROM=
VIGIL_ALERT_EMAIL_TO=
# Slack incoming webhook URL.
VIGIL_SLACK_WEBHOOK_URL=
# Generic webhook, signed with X-Vigil-Signature: t=<unix>,v1=HMAC-SHA256(secret, "t.body").
VIGIL_ALERT_WEBHOOK_URL=
VIGIL_ALERT_WEBHOOK_SECRET=

# --- Drill (scripts/drill.ts) --------------------------------------------------------------
# Only localhost or hosts listed in DRILL_ALLOWED_HOSTS, and only NEXORA instances you own.
DRILL_TARGET_URL=
DRILL_ALLOWED_HOSTS=
# An integration key (no security scopes) created for the drill in that NEXORA instance.
DRILL_API_KEY=
