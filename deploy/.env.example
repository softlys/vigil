# Copy to deploy/.env for docker compose. Never commit the filled-in file.

# Database password for the bundled PostgreSQL: openssl rand -hex 24
POSTGRES_PASSWORD=

# Required on a server.
VIGIL_MODE=production
# First admin, created on the first start; must change the password at first sign-in (12+ characters).
VIGIL_ADMIN_EMAIL=
VIGIL_ADMIN_PASSWORD=
VIGIL_PUBLIC_URL=https://vigil.example.com

# NEXORA connector: two SIEM keys from NEXORA → Settings → API keys.
NEXORA_URL=https://nexora.example.com
NEXORA_SECURITY_API_KEY=
NEXORA_RESPONSE_API_KEY=

# One reverse proxy in front of VIGIL appends X-Forwarded-For.
VIGIL_TRUSTED_PROXY_HOPS=1

# Optional: notifications for high-severity alerts
RESEND_API_KEY=
VIGIL_ALERT_EMAIL_FROM=
VIGIL_ALERT_EMAIL_TO=
VIGIL_SLACK_WEBHOOK_URL=
VIGIL_ALERT_WEBHOOK_URL=
VIGIL_ALERT_WEBHOOK_SECRET=
APP_RELEASE=
